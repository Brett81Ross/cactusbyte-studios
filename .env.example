# Firebase web client configuration
# Copy this file to .env.local for local development and set the real values there.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key

# Server-only Firebase Admin credentials. Never expose these with NEXT_PUBLIC_ prefixes.
FIREBASE_ADMIN_PROJECT_ID=cactusbyte-studios
FIREBASE_ADMIN_CLIENT_EMAIL=your_service_account_email
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Optional explicit Firebase UID for the studio owner. If omitted, the server finds the first profile with role=owner.
OWNER_FIREBASE_UID=optional_owner_firebase_uid

# Trusted owner-device setup. Generate both values as long random secrets and keep them server-only.
OWNER_DEVICE_SETUP_SECRET=one_time_private_owner_setup_code
OWNER_DEVICE_SIGNING_SECRET=generate_a_long_random_owner_device_signing_secret

# Server-only Stripe provisioning credentials.
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_CHECKOUT_SIGNING_SECRET=generate_a_long_random_secret_for_checkout_identity_binding
# Optional. If omitted, CactusByte finds or creates its own restricted customer-portal configuration.
STRIPE_PORTAL_CONFIGURATION_ID=optional_bpc_configuration_id

# Server-only OpenAI credentials for owner-triggered Idea Radar web research.
OPENAI_API_KEY=your_openai_api_key
# Optional model override. The default in code is gpt-5.5.
OPENAI_IDEA_RADAR_MODEL=gpt-5.5

# OrbitGather signing-cutover identity recovery bridge.
# Configure the exact same long random value in CactusByte and the OrbitGather Supabase recovery Edge Function.
# Never expose it through a NEXT_PUBLIC_ variable or client bundle.
ORBITGATHER_RECOVERY_BRIDGE_SECRET=replace_with_same_long_random_server_only_secret_used_by_orbitgather_recovery_function

# Optional server-only isolation namespace for runtime/device QA.
# When set, recovery profiles/bindings/tokens/rate records/events are written under
# identityRecoveryNamespaces/<namespace>/... instead of production recovery collections.
# Leave unset in production. Example staging value: phase7-orbitgather-zfold-qa
CACTUSBYTE_IDENTITY_RECOVERY_NAMESPACE=
